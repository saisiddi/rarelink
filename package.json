{
  "name": "rarelink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RARELINK — Emergency rare blood discovery & donor coordination platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:init": "node --experimental-strip-types scripts/init-db.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:reset": "node --experimental-strip-types scripts/reset-db.ts",
    "setup": "npm run db:init && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ui": "node --experimental-strip-types scripts/browser-check.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
