# ---------------------------------------------------------------------------
# RARELINK environment configuration
# Copy to `.env.local` and fill in the values you have. Everything below is
# OPTIONAL — the app runs fully on its bundled demo/verified dataset without
# any of these set.
# ---------------------------------------------------------------------------

# --- AI (OpenRouter) -------------------------------------------------------
# Server-side only. NEVER expose this to the browser.
OPENROUTER_API_KEY=
# Configurable model — do not hard-code.
OPENROUTER_MODEL=google/gemma-3-27b-it
# Optional: identify your app to OpenRouter.
OPENROUTER_APP_NAME=RARELINK
# Force-disable the LLM path even if a key is present (used in tests/demo).
AI_DISABLED=false

# --- Database --------------------------------------------------------------
# SQLite by default. Point at a file; it is created on first run.
DATABASE_PATH=./data/rarelink.db

# --- Data freshness thresholds (minutes) -----------------------------------
FRESHNESS_LIVE_MINUTES=30
FRESHNESS_RECENT_MINUTES=180
FRESHNESS_STALE_MINUTES=720

# --- Geocoding -------------------------------------------------------------
# "local" (bundled Indian city/area gazetteer, default) | "nominatim"
GEOCODING_PROVIDER=local
# Only used when GEOCODING_PROVIDER=nominatim. Self-host in production —
# the public Nominatim instance must not be used for high-volume search.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=RARELINK/0.1 (contact: admin@example.com)

# --- Blood data providers --------------------------------------------------
# Comma separated: local,eraktkosh,ircs
BLOOD_DATA_PROVIDERS=local
ERAKTKOSH_BASE_URL=
IRCS_BASE_URL=

# --- Security --------------------------------------------------------------
# Secret used to sign the demo-session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me
# Requests per minute per IP for the AI endpoint.
AI_RATE_LIMIT_PER_MINUTE=20
